# SideQuest environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# GitHub personal access token with `repo` scope (used by Octokit for branch/PR ops).
GITHUB_TOKEN=

# --- LLM provider (Amazon Bedrock, default) ---
# AWS credentials/region for Bedrock. The LLMProvider seam reads these from the env.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: the Bedrock model id to invoke.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- Fallback LLM provider (used only if Bedrock is unavailable within the setup window) ---
# Set ONE of these if you swap the LLMProvider to a non-Bedrock API.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Mock server ---
# Port for `npm run mock` (defaults to 4000 when unset).
PORT=4000
