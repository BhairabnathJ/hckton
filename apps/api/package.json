{
  "name": "@sidequest/api",
  "version": "0.0.0",
  "private": true,
  "description": "SideQuest API — api-contract deliverables: OpenAPI 3 file + one-command mock server.",
  "type": "module",
  "exports": {
    "./llm": "./src/llm/index.ts"
  },
  "scripts": {
    "openapi": "tsx src/mock/openapi.ts",
    "mock": "tsx src/mock/server.ts",
    "check": "tsx src/mock/check.ts",
    "smoke": "bash scripts/smoke.sh",
    "smoke:demo": "bash scripts/smoke-demo.sh",
    "smoke:workspace": "bash scripts/smoke-workspace.sh",
    "mock:smoke": "tsx src/mock/smoke.ts",
    "llm:test": "tsx src/llm/test.ts",
    "dev": "tsx src/server.ts",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate",
    "prisma:push": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db push --skip-generate",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@google/genai": "2.31.0",
    "@prisma/client": "5.22.0",
    "@sidequest/shared": "*",
    "express": "4.22.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
