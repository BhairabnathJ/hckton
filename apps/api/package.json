    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
