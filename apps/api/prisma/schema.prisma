// SideQuest core-api data model (build-plan spec #4) + marketplace (spec #5).
//
// Mirrors /docs/architecture.md §3. SQLite today (Postgres-compatible for a
// later migration): enums and JSON are stored as String and validated at the
// edge by the shared zod enums, so the service code round-trips through the
// contract and the Postgres swap changes no service.
//
// Marketplace adds `Company` and `Job` (minimal scope: no `Submission` entity;
// the submitted PR url and claim/escrow state live as fields on `Job`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  handle         String   @unique // resolved from X-Demo-User (// MOCK)
  name           String
  school         String
  xp             Int      @default(0)
  level          Int      @default(1)
  rating         Float    @default(0)
  workAuthorized Boolean  @default(false)
  telemetryOptIn Boolean  @default(false) // opt-in OFF by default (§6)
  role           String   @default("student") // "student" | "company" (// MOCK auth)
  createdAt      DateTime @default(now())

  attempts        Attempt[]
  telemetryEvents TelemetryEvent[]
}

model SimCompany {
  id              String   @id @default(cuid())
  name            String
  repoTemplateUrl String
  createdAt       DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id                 String     @id // e.g. "brightline-l1-pagination"
  simCompanyId       String
  simCompany         SimCompany @relation(fields: [simCompanyId], references: [id])
  repo               String
  level              Int
  title              String
  description        String
  acceptanceCriteria String // JSON array (string[]) serialized
  branch             String
  difficulty         String
  xpReward           Int
  hiddenTestRef      String // SERVER-ONLY: never serialized to a client (§6)
  createdAt          DateTime   @default(now())

  attempts Attempt[]
}

model Attempt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
  branch       String?
  prUrl        String?
  status       String   @default("in_progress") // Attempt state machine (§5)
  testRuns     Int      @default(0)
  reviewRounds Int      @default(0)
  hintsUsed    Int      @default(0)
  startedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gradeRuns GradeRun[]
  review    Review?
  hintLogs  HintLog[]
}

model GradeRun {
  id          String   @id @default(cuid())
  attemptId   String
  attempt     Attempt  @relation(fields: [attemptId], references: [id])
  passed      Boolean
  testsPassed Int
  testsTotal  Int
  logExcerpt  String // bounded, sanitized (never hidden-test source) (§6)
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())
}

model Persona {
  id           String  @id // "pm" | "coach"
  name         String
  voice        String
  systemPrompt String

  reviews Review[]
}

model Review {
  id           String   @id @default(cuid())
  attemptId    String   @unique // Attempt 1:1 (optional) Review
  attempt      Attempt  @relation(fields: [attemptId], references: [id])
  personaId    String
  persona      Persona  @relation(fields: [personaId], references: [id])
  summary      String
  commentsJson String
  advisoryPass Boolean
  createdAt    DateTime @default(now())
}

model HintLog {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  persona   String // "pm" | "coach"
  question  String
  response  String
  createdAt DateTime @default(now())
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String // event type
  propsJson String // bounded, anonymized, no PII (§6)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// marketplace (build-plan spec #5) — Company + Job.
//
// Per the reconciled architecture §3/§5. No `Submission` entity is modeled
// (minimal marketplace scope): the submitted PR url lives on the Job via
// `prUrl`, and claim/escrow state live on the Job (`claimedByUserId`,
// `claimExpiresAt`, `escrowStatus`) — no separate Claim/EscrowTransaction.
// ---------------------------------------------------------------------------

model Company {
  id   String @id @default(cuid())
  name String
  size String

  jobs Job[]
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  title           String
  description     String
  payCents        Int
  timeLimitHours  Int
  minLevel        Int       @default(6)
  status          String    @default("open") // Job state machine (§5)
  claimedByUserId String? // the claimant (no separate Claim entity)
  claimExpiresAt  DateTime?
  prUrl           String? // submitted PR (no separate Submission entity)
  escrowStatus    String    @default("funded") // // MOCK: funded|released|refunded (§7)
  droppedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
