# Base URL the web app calls. "/api" goes through the Vite dev proxy
# (see vite.config.ts); set an absolute URL only if the API serves CORS headers.
VITE_API_URL=/api

# MOCK: X-Demo-User handles offered in the header switcher. Handles the API
# doesn't know (401) are hidden. core-api seeds maya, jordan, admin; the mock
# server seeds ada, grace.
VITE_DEMO_USERS=maya,jordan,admin,ada,grace

# Company used by the "Post a job" form (no GET /companies endpoint yet).
VITE_DEMO_COMPANY_ID=company_northwind
